# העתק קובץ זה ל-.env ומלא את הערכים. אל תעלה את .env ל-GitHub.

# ספק המודלים: openai או openrouter
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...

# OpenRouter (למודלים חינמיים ו/או כספק חלופי)
OPENROUTER_API_KEY=sk-or-...

# LangSmith – ניטור ריצות
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=ai-rights-assistant
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # רק אם החשבון נפתח באזור EU

# אופציונלי: מודל ברירת מחדל
# RIGHTS_MODEL=gpt-5.4-mini
